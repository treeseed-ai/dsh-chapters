---
/** The benefits — one editorial section each: name, what it means to you,
 * and the documentation that goes deeper. Flat rules between entries, no cards. */
const base = import.meta.env.BASE_URL;
const L = (href: string, label: string) => ({ href, label });
const benefits = [
  { t: 'Compaction that costs zero inference tokens',
    b: 'Summarizing a conversation means feeding the whole history through the model again — an hour of wall-clock on local hardware, every time the window fills. dsh-chapters writes chapters by copying its own record and derives the index deterministically. The production run archived 680K tokens of agent memory and spent exactly zero tokens doing it.',
    links: [L('concepts/why-not-summaries/', 'Why not summaries'), L('concepts/budget/', 'Budget math')] },
  { t: 'Verbatim memory your agents actually use',
    b: '“Lossless” usually means a paraphrase you must trust. Here the archive is byte-true text on disk, and retrieval is a normal move agents make: in the documented run, the agents reached back into it 49 times — 49 successes, ~497 KB restored — including re-consulting a 24K-token artifact after compaction had dropped it from context.',
    links: [L('concepts/archive-anatomy/', 'Anatomy of the archive'), L('evidence/field-study/', 'The field study')] },
  { t: 'Nothing is ever destroyed',
    b: 'The session log is append-only and compaction only shadows it. The original session stays open, cacheable, auditable, and reversible: fork a branch, abandon it, keep working in the parent. Your history outlives every experiment.',
    links: [L('concepts/invariants/', 'The four invariants'), L('operations/security/', 'Integrity guarantees')] },
  { t: 'New sessions start with a map, not a burden',
    b: 'A continuation opens with one message: a chronological Table of Contents of everything archived before it. Measured cost: ~102 tokens of index against the ~2,476-token transcript it replaces — and unlike a summary, every line is a door back to the full bytes.',
    links: [L('reference/notice/', 'The notice, annotated'), L('start/first-continuation/', 'Walkthrough')] },
  { t: 'The tool-output firehose, defused at arrival',
    b: 'Oversized results — the 40K-line log, the lockfile cat — are stubbed before they ever enter context and stored content-addressed, then re-inspected through toc / search / windowed reads. A 373 KB book was fetched live with zero blob prefills; the recursion follows the Recursive Language Model result, minus the sandbox.',
    links: [L('concepts/recursive-context/', 'Recursive-context theory'), L('reference/tools/', 'chapters_artifact')] },
  { t: 'One link turns session memory into team memory',
    b: 'Point a workspace at a knowledge pool — a plain git repo (even a local path, no credentials) or a TreeDX service — and every linked session searches the shared corpus: ranked, topic-aware, with machine-stamped provenance. The link is per project, so it carries to every session and sub-agent automatically.',
    links: [L('start/link-pool/', 'Link a pool'), L('knowledge/pool/', 'How pools work'), L('knowledge/providers/', 'git vs TreeDX')] },
  { t: 'Built for the model on your own GPU',
    b: 'The thesis is small models, more capable: the whole system ran its proof-of-work on a 64K-context local model in 8 GB of VRAM. No embeddings, no vector DB, no server, no telemetry — Markdown files your tools can grep, and honest arithmetic on what the single KV slot can cache.',
    links: [L('evidence/llamacpp-cache/', 'Cache reality on llama.cpp'), L('operations/install/', 'Requirements & install')] },
  { t: 'Team steering that respects every machine',
    b: 'Rules are write-once proposals that bind only after each machine approves — the approval is a curation fact of that box, never a shared rewrite. Approved rules ride verbatim into continuation notices under a budget that refuses with numbers rather than clipping a line.',
    links: [L('knowledge/rules/', 'Rules & governance'), L('knowledge/search/', 'Rule-aware ranking')] },
  { t: 'Loud honesty, from the engine to the evidence',
    b: 'Offline degrades to local-only with the failed step named; thresholds refuse rather than silently truncate; refusals log their reason to your diagnostics file. The CI cannot fake green — acceptance replays seven browser journeys from committed model tapes and fails loudly on any miss.',
    links: [L('operations/development/', 'The tape discipline'), L('start/faq/', 'Troubleshooting')] },
  { t: 'Continuity you can click',
    b: 'Under every assistant message: “Fork with chapters” — archive, continue, switch sessions in one click, no ritual to memorize. Command surfaces, tool schemas, and the config reference are laid out for humans and agents alike in Part IV of the book.',
    links: [L('reference/commands/', 'Commands'), L('reference/configuration/', 'Configuration')] },
];
---
<div class="dsh-benefits">
  {benefits.map((f, i) => (
    <section class="dsh-benefit">
      <div class="n">{String(i + 1).padStart(2, '0')}</div>
      <div>
        <h3>{f.t}</h3>
        <p>{f.b}</p>
        <div class="more">
          <span>Go deeper:</span>
          {f.links.map((l) => <a href={`${base}${l.href}`}>{l.label}</a>)}
        </div>
      </div>
    </section>
  ))}
</div>
