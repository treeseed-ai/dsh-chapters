---
/** Overview / getting-started banner — flat editorial style, no bubbles.
 * Category up top, one-sentence promise, what it is, install line, CTA row, live trust cues. */
import InstallCard from './InstallCard.astro';
const base = import.meta.env.BASE_URL;
---
<section class="dsh-banner">
  <div class="dsh-kicker">Open-source memory layer for coding agents · a DeepSeek Harness plugin</div>
  <h1>Your model ran out of context.<br/>Your work didn't have to.</h1>
  <p class="lead">
    When the window fills, dsh-chapters archives the conversation as <strong>verbatim chapters</strong> —
    copied straight from the session log, never re-typed by a model — and opens the next session with a
    one-paragraph table of contents of everything. Compaction costs <strong>zero inference tokens</strong>.
    Nothing is rewritten, nothing is paraphrased, and every byte stays retrievable — on one 8&nbsp;GB GPU.
    No API key, no vector database, no cloud subscription between you and your own memory.
  </p>

  <InstallCard />

  <div class="dsh-actions">
    <a class="dsh-btn" href={`${base}start/quickstart/`}>Start here — the quickstart →</a>
    <a class="dsh-btn ghost" href={`${base}evidence/field-study/`}>See the production receipts</a>
    <a class="dsh-btn ghost" href="https://github.com/treeseed-ai/dsh-chapters">GitHub</a>
  </div>

  <div class="dsh-badges" aria-label="Project status">
    <img alt="GitHub stars" src="https://img.shields.io/github/stars/treeseed-ai/dsh-chapters?style=flat-square&logo=github&labelColor=1b2523&color=35c79b">
    <img alt="npm version" src="https://img.shields.io/npm/v/@treeseed/dsh-chapters?style=flat-square&logo=npm&labelColor=1b2523&color=35c79b">
    <img alt="npm downloads" src="https://img.shields.io/npm/dm/@treeseed/dsh-chapters?style=flat-square&labelColor=1b2523&color=7f9a91">
    <img alt="CI status" src="https://img.shields.io/github/actions/workflow/status/treeseed-ai/dsh-chapters/ci.yml?style=flat-square&label=CI%20%2B%20tape%20acceptance&labelColor=1b2523&color=35c79b">
    <img alt="Provenance" src="https://img.shields.io/badge/provenance-SLSA%20v1-brightgreen?style=flat-square&labelColor=1b2523">
  </div>
</section>
