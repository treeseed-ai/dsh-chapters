# DSH Chapters Dev — Environment Configuration
# Copy to .env and adjust values for your setup.

# ── DSH Host ───────────────────────────────────────────────────────────────────
# Version of @deepseek-ai/dsh to install (used by Dockerfile build arg)
DSH_HOST_VERSION=latest

# Port the DSH Web UI listens on (host-mapped)
DSH_PORT=3080

# ── vLLM Model Server ─────────────────────────────────────────────────────────
# The vLLM service serves Qwen3-4B-AWQ under two model names.
# Inference: qwen3-4b-instruct | Decision: qwen3-4b-systemone

# HuggingFace model ID to serve
VLLM_MODEL_ID=Qwen/Qwen3-4B-AWQ

# Space-separated model aliases exposed via the API. vLLM's --served-model-name
# is variadic: ONE flag, space-separated values. Commas or repeated flags make
# all but one alias 404 (measured on vLLM 0.31).
VLLM_SERVED_NAMES=qwen3-4b-instruct qwen3-4b-systemone

# Maximum context length in tokens
VLLM_MAX_MODEL_LEN=32768

# GPU memory utilization (0.0–1.0). vLLM measures FREE memory at startup: on a
# box whose GPU is shared with the desktop compositor, 0.90 aborts with
# "Free memory ... less than desired GPU memory utilization". 0.75 fits 16 GB
# GPUs under a desktop session (measured: ~13 GiB free of 15.58).
VLLM_GPU_MEM=0.75

# Tensor parallel size (1 = single GPU, 2+ for multi-GPU)
VLLM_TP_SIZE=1

# Host port for the vLLM server
VLLM_PORT=8080

# HuggingFace token (only needed for gated models)
HF_TOKEN=

# ── LLM Provider (for DSH) ───────────────────────────────────────────────────
# Points at the vLLM service inside the Docker network.
# For native (non-container) use, change to http://localhost:8080/v1
LLM_BASE_URL=http://vllm:8080/v1
LLM_MODEL=qwen3-4b-instruct
LLM_CONTEXT_WINDOW=32768
LLM_MAX_TOKENS=15000
LOCAL_API_KEY=sk-local

# ── SystemOne Decision Endpoint ───────────────────────────────────────────────
# Same vLLM server, different model name for semantic routing
SYSTEMONE_BASE_URL=http://vllm:8080/v1
SYSTEMONE_MODEL=qwen3-4b-systemone

# ── Plugin API Keys (optional) ────────────────────────────────────────────────
# Alibaba Qwen Token Plan API key (enables cloud marketplace models)
# QWEN_TOKEN_PLAN_API_KEY=

# Tinyfish search API key (enables web search plugin)
# TINYFISH_API_KEY=

# ── Image Tag ──────────────────────────────────────────────────────────────────
IMAGE_TAG=latest

# ── SDK API Service (compose.sdk.yml, #25) ───────────────────────────────────
# Entrypoint role for the shared image. compose.yml runs the Web UI; this file
# is compose.sdk.yml — its default is `gateway` and that is the value .env must
# carry, or the SDK stack silently boots a Web UI nobody asked for.
DSH_ROLE=gateway

# WebSocket port the SDK gateway publishes (callers connect ws://host:8765).
GATEWAY_PORT=8765

# Shared secret for the gateway — REQUIRED by compose.sdk.yml (the container
# refuses to boot without it; this surface executes code). Clients offer it as
# Sec-WebSocket-Protocol: dsh-auth.<token>. Generate: openssl rand -hex 16
GATEWAY_TOKEN=

# Optional per-consumer API keys (#32), comma-separated. When set, clients may
# authenticate with `Authorization: Bearer <key>` (or dsh-bearer.<key>
# subprotocol) IN ADDITION to the GATEWAY_TOKEN path above. Unset = feature off,
# zero behavior change. Log lines name WHICH key accepted, never the secret.
GATEWAY_API_KEYS=

# Reap an idle connection (no frames) after this many ms. One connection owns
# one `dsh --profile sdk` child, so this is also the orphan-runtime bound.
GATEWAY_IDLE_MS=1800000

# initialize-handshake bound for spawned children (vLLM cold GPU boot counts).
GATEWAY_INIT_TIMEOUT_MS=30000

# Profile name the gateway spawns (entrypoint composes its patch at boot).
DSH_SDK_PROFILE=sdk
