# DSH Chapters Dev — Environment Configuration
# Copy to .env and adjust values for your setup.

# ── DSH Host ───────────────────────────────────────────────────────────────────
# Version of @deepseek-ai/dsh to install (used by Dockerfile build arg)
DSH_HOST_VERSION=latest

# Port the DSH Web UI listens on (host-mapped)
DSH_PORT=3080

# ── vLLM Model Server ─────────────────────────────────────────────────────────
# The vLLM service serves Qwen3-4B-AWQ under two model names.
# Inference: qwen3-4b-instruct | Decision: qwen3-4b-systemone

# HuggingFace model ID to serve
VLLM_MODEL_ID=Qwen/Qwen3-4B-AWQ

# Comma-separated model aliases exposed via the API
VLLM_SERVED_NAMES=qwen3-4b-instruct,qwen3-4b-systemone

# Maximum context length in tokens
VLLM_MAX_MODEL_LEN=32768

# GPU memory utilization (0.0–1.0)
VLLM_GPU_MEM=0.90

# Tensor parallel size (1 = single GPU, 2+ for multi-GPU)
VLLM_TP_SIZE=1

# Host port for the vLLM server
VLLM_PORT=8080

# HuggingFace token (only needed for gated models)
HF_TOKEN=

# ── LLM Provider (for DSH) ───────────────────────────────────────────────────
# Points at the vLLM service inside the Docker network.
# For native (non-container) use, change to http://localhost:8080/v1
LLM_BASE_URL=http://vllm:8080/v1
LLM_MODEL=qwen3-4b-instruct
LLM_CONTEXT_WINDOW=32768
LLM_MAX_TOKENS=15000
LOCAL_API_KEY=sk-local

# ── SystemOne Decision Endpoint ───────────────────────────────────────────────
# Same vLLM server, different model name for semantic routing
SYSTEMONE_BASE_URL=http://vllm:8080/v1
SYSTEMONE_MODEL=qwen3-4b-systemone

# ── Plugin API Keys (optional) ────────────────────────────────────────────────
# Alibaba Qwen Token Plan API key (enables cloud marketplace models)
# QWEN_TOKEN_PLAN_API_KEY=

# Tinyfish search API key (enables web search plugin)
# TINYFISH_API_KEY=

# ── Image Tag ──────────────────────────────────────────────────────────────────
IMAGE_TAG=latest
