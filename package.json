{
  "name": "@treeseed/dsh-chapters",
  "version": "0.2.0",
  "description": "dsh plugin: verbatim chapter archive + zero-token index for small-context models",
  "type": "module",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./engine": "./lib/engine.js",
    "./preset": "./lib/preset.js",
    "./tools": "./lib/tools.js",
    "./store": "./lib/store.js",
    "./registry": "./lib/registry.js",
    "./client": "./lib/client.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": false,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.strict.json",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "build": "tsc -p tsconfig.json && tsdown -c tsdown.client.config.ts --config-loader tsx",
    "corpus:stamp": "node scripts/build-stamp.mjs stamp",
    "corpus:check": "node scripts/build-stamp.mjs check",
    "build:client": "tsdown -c tsdown.client.config.ts",
    "test:unit": "node --test tests/unit/*.test.ts",
    "e2e:one": "bash scripts/e2e-one.sh",
    "e2e:harness:live": "E2E_PROVIDER=harness MODE=live bash scripts/e2e-one.sh",
    "corpus:heal": "E2E_PROVIDER=harness MODE=heal bash scripts/e2e-one.sh",
    "corpus:record": "E2E_PROVIDER=harness MODE=record bash scripts/e2e-one.sh",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=$PWD/var/ms-playwright npx playwright test -c tests/e2e/playwright.config.ts --project=suite && PLAYWRIGHT_BROWSERS_PATH=$PWD/var/ms-playwright npx playwright test -c tests/e2e/playwright.config.ts --project=heavy && PLAYWRIGHT_BROWSERS_PATH=$PWD/var/ms-playwright npx playwright test -c tests/e2e/playwright.config.ts --project=arrival && PLAYWRIGHT_BROWSERS_PATH=$PWD/var/ms-playwright npx playwright test -c tests/e2e/playwright.config.ts --project=enrich && PLAYWRIGHT_BROWSERS_PATH=$PWD/var/ms-playwright npx playwright test -c tests/e2e/playwright.config.ts --project=fanout && PLAYWRIGHT_BROWSERS_PATH=$PWD/var/ms-playwright npx playwright test -c tests/e2e/playwright.config.ts --project=rules && PLAYWRIGHT_BROWSERS_PATH=$PWD/var/ms-playwright npx playwright test -c tests/e2e/playwright.config.ts --project=fork && PLAYWRIGHT_BROWSERS_PATH=$PWD/var/ms-playwright npx playwright test -c tests/e2e/playwright.config.ts --project=plans && PLAYWRIGHT_BROWSERS_PATH=$PWD/var/ms-playwright npx playwright test -c tests/e2e/playwright.config.ts --project=prompt && PLAYWRIGHT_BROWSERS_PATH=$PWD/var/ms-playwright npx playwright test -c tests/e2e/playwright.config.ts --project=prompt-off",
    "test:all": "npm test && npm run test:e2e",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:e2e:record": "E2E_MODEL=record npm run test:e2e",
    "test:e2e:replay": "E2E_MODEL=replay bash scripts/chain-replay.sh",
    "coverage:e2e": "E2E_COVERAGE=1 PLAYWRIGHT_BROWSERS_PATH=$PWD/var/ms-playwright npm run test:e2e:replay && node scripts/e2e-coverage.mjs",
    "coverage": "node --test --experimental-test-coverage tests/unit/*.test.ts tests/integration/*.test.ts",
    "coverage:ci": "c8 --check-coverage --statements 85 --branches 85 --functions 85 --lines 85 --reporter=text-summary --reporter=json-summary --report-dir var/coverage node --test tests/unit/*.test.ts tests/integration/*.test.ts",
    "test:e2e:cache": "E2E_PORT=41739 PLAYWRIGHT_BROWSERS_PATH=$PWD/var/ms-playwright playwright test -c tests/e2e/playwright.config.ts --project=cache",
    "bench": "node benchmarks/run-bench.mjs",
    "bench:nightly": "node benchmarks/run-bench.mjs --every 60",
    "docs:dev": "npm --prefix site run dev",
    "docs:build": "npm --prefix site run build",
    "mining:probe": "node scripts/mining-probe.mjs",
    "llm:where": "node -e \"import('./scripts/llm.mjs').then(async m=>{const t=await m.resolve({});console.log(t.base,t.model,t.regime,'| credential:',m.apiKeySource(),'| key found:',m.apiKey()!==null)})\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/cordis-plugin-loader": "*",
    "@deepseek-ai/dsh-compaction": "*",
    "@deepseek-ai/dsh-compaction-basic": "*",
    "@deepseek-ai/dsh-home-paths": "*",
    "@deepseek-ai/dsh-storage-domain": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-compaction-basic": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/cordis-plugin-loader": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.4",
    "@deepseek-ai/dsh-agent": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-commands": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-compaction-basic": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-scope": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session-format-v3-to-v4": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-storage": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-storage-domain": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "3.18.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.3",
    "@types/react": "~18.3.1",
    "c8": "^12.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "isomorphic-git": "^1.42.2",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/treeseed-ai/dsh-chapters.git"
  },
  "homepage": "https://github.com/treeseed-ai/dsh-chapters#readme",
  "bugs": {
    "url": "https://github.com/treeseed-ai/dsh-chapters/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
